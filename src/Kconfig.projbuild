menu "UVR1611 I/O Configuration"

    menu "Sensor Names (S1-S16)"
        config SENSOR_S1_NAME
            string "S1 Sensor Name"
            default "T.Heizkr.VL"
            help
                Heizkreis Vorlauf Temperatur

        config SENSOR_S2_NAME
            string "S2 Sensor Name"
            default "T.Heizkr.RL"
            help
                Heizkreis Ruecklauf Temperatur

        config SENSOR_S3_NAME
            string "S3 Sensor Name"
            default "T.Heizkr.VL1"
            help
                Radiatoren Vorlauf Temperatur

        config SENSOR_S4_NAME
            string "S4 Sensor Name"
            default "T.Heizkr.VL2 FB"
            help
                Fussbodenheizung Vorlauf Temperatur

        config SENSOR_S5_NAME
            string "S5 Sensor Name"
            default "Temp.Raum"
            help
                Raumtemperatur

        config SENSOR_S6_NAME
            string "S6 Sensor Name"
            default "Temp.Raum1"
            help
                Raumtemperatur 1

        config SENSOR_S7_NAME
            string "S7 Sensor Name"
            default "T.Boiler"
            help
                Boiler Temperatur

        config SENSOR_S8_NAME
            string "S8 Sensor Name"
            default "T.Boiler.u"
            help
                Boiler unten Temperatur

        config SENSOR_S9_NAME
            string "S9 Sensor Name"
            default "T.Kollektor"
            help
                Solar Kollektor Temperatur

        config SENSOR_S10_NAME
            string "S10 Sensor Name"
            default "---"
            help
                Unused

        config SENSOR_S11_NAME
            string "S11 Sensor Name"
            default "---"
            help
                Unused

        config SENSOR_S12_NAME
            string "S12 Sensor Name"
            default "---"
            help
                Unused

        config SENSOR_S13_NAME
            string "S13 Sensor Name"
            default "---"
            help
                Unused

        config SENSOR_S14_NAME
            string "S14 Sensor Name"
            default "---"
            help
                Unused

        config SENSOR_S15_NAME
            string "S15 Sensor Name"
            default "Durchfl.HKR"
            help
                Durchfluss Heizkreis (l/h)

        config SENSOR_S16_NAME
            string "S16 Sensor Name"
            default "---"
            help
                Unused
    endmenu

    menu "Output Names (A1-A13)"
        config OUTPUT_A1_NAME
            string "A1 Output Name"
            default "Pump-Hzkr1"
            help
                Pumpe Heizkreis 1 Radiatoren

        config OUTPUT_A2_NAME
            string "A2 Output Name"
            default "Pumpe-Hzkr2 FB"
            help
                Pumpe Fussbodenheizung

        config OUTPUT_A3_NAME
            string "A3 Output Name"
            default "Misch Hzkr1"
            help
                Mischer Heizkreis 1 Radiatoren

        config OUTPUT_A4_NAME
            string "A4 Output Name"
            default "Misch Zu"
            help
                Mischer Zu

        config OUTPUT_A5_NAME
            string "A5 Output Name"
            default "A5"
            help
                Not labeled

        config OUTPUT_A6_NAME
            string "A6 Output Name"
            default "Ventil"
            help
                Ventil

        config OUTPUT_A7_NAME
            string "A7 Output Name"
            default "Pumpe-Solar"
            help
                Pumpe Solar

        config OUTPUT_A8_NAME
            string "A8 Output Name"
            default "Misch Hzkr2 Auf"
            help
                Mischer FB Auf

        config OUTPUT_A9_NAME
            string "A9 Output Name"
            default "Misch FB Zu"
            help
                Mischer FB Zu

        config OUTPUT_A10_NAME
            string "A10 Output Name"
            default "LadePWW"
            help
                Warmwasser Ladung

        config OUTPUT_A11_NAME
            string "A11 Output Name"
            default "A11"
            help
